<?xml version="1.0" ?>
<!--
  tb3_office_sim: office_arena.sdf
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Gazebo Harmonic (gz-sim 8) / ROS 2 Jazzy

  A fully enclosed 4 m (x: -2 .. +2) x 8 m (y: -4 .. +4) office room.

  Coordinate convention for this file (meters, SDF pose = center of model):
    x  |  description
  ~~~~+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  0.0 | room center (TurtleBot3 spawns here)
  +-2 | east/west inner wall faces
  +-4 | north/south inner wall faces
  Wall boxes are 0.20 m thick and 1.20 m tall.

  Editing guide: every model below has a <pose> (position) and a
  <geometry><box><size> (dimensions). Move a desk by changing its <pose>;
  re-shape it by changing <size>. Keep static models OUTSIDE the robot's
  drivable area (keep aisles ~> 0.7 m).

  The TurtleBot3 Burger is NOT in this file. It is injected at launch time
  by launch/office_world.launch.py (ros_gz_sim `create` + /robot_description).
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<sdf version="1.9">
  <world name="office_arena">

    <!-- ================= Physics & plugins (Harmonic) ================= -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required so the lidar sensor renders on the GPU. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ======================== Lighting =============================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ====================== Ground plane ============================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12 16 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Explicit grip for the planted floor: without a surface
                     definition the DiffDrive wheels slip badly (odom counts
                     ~1.8x the real motion). mu/mu2 2.0 keeps the Burger
                     driving where cmd_vel points. -->
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 16 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================== Enclosure walls (static) ==================== -->
    <!-- Each wall: 0.20 thick, 1.20 tall. Inner faces sit exactly on
         x=+/-2 (east/west) and y=+/-4 (north/south), so the drivable
         interior is a clean 4.0 m x 8.0 m rectangle - the same numbers
         the lidar will paint on the map and compare_map.py checks. -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>2.1 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.1 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Office furniture ========================== -->
    <!-- All obstacles are <static> so the lidar reflects off them but the
         physics engine never moves them. -->

    <!-- Center table: gives the robot near-field structure at spawn. -->
    <model name="table_center">
      <static>true</static>
      <pose>0 0.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- West desk (1.6 x 0.9 x 0.75). Kept clear of the wall inner face
         (x = -2.0): spans x in [-1.95, -0.35]. -->
    <model name="desk_west">
      <static>true</static>
      <pose>-1.15 -2.2 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.6 0.9 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.6 0.9 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.72 1</ambient>
            <diffuse>0.7 0.7 0.72 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- East desk (1.6 x 0.9 x 0.75). Kept clear of the wall inner face
         (x = +2.0): spans x in [0.35, 1.95]. -->
    <model name="desk_east">
      <static>true</static>
      <pose>1.15 2.2 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.6 0.9 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.6 0.9 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.72 1</ambient>
            <diffuse>0.7 0.7 0.72 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Chairs: thin column leg + seat disc + backrest box.
         Seat radius shrunk to 0.08 (from 0.22) and chair_west tucked into
         the shelf so the N-S corridor at x ~ -1.3 stays passable. -->
    <model name="chair_west">
      <static>true</static>
      <pose>-1.62 -1.45 0 0 0 0</pose>
      <link name="link">
        <collision name="leg">
          <pose>0 0 0.235 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.47</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg">
          <pose>0 0 0.235 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.47</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="seat">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="seat">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="backrest">
          <pose>0 -0.2 0.78 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.05 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="backrest">
          <pose>0 -0.2 0.78 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="chair_east">
      <static>true</static>
      <pose>1.35 1.45 0 0 0 0</pose>
      <link name="link">
        <collision name="leg">
          <pose>0 0 0.235 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.47</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg">
          <pose>0 0 0.235 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.47</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="seat">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="seat">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="backrest">
          <pose>0 0.2 0.78 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.05 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="backrest">
          <pose>0 0.2 0.78 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Filing cabinet near the south wall (1.2 x 0.5 x 1.6) -->
    <model name="cabinet_south">
      <static>true</static>
      <pose>0.0 -3.2 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.5 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.5 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall shelf against the west wall (0.4 x 2.6 x 1.8) -->
    <model name="shelf_west">
      <static>true</static>
      <pose>-1.68 0.6 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 2.6 1.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 2.6 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>